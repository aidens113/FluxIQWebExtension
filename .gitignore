node_modules/
dist/
.fluxiq/
.turbo/
.DS_Store
*.log

# Local test-target configuration and credentials. Commit only .env.example.
.env
.env.local
.env.*.local
!.env.example

# Automated testing facility outputs and disposable browser state.
test-runs/
.browser-profiles/
playwright-report/
test-results/
.playwright/

# Generated esbuild bundle for the FluxIQ setup CLI. Regenerated by
# "pnpm fluxiq:setup" and "pnpm dev"; never commit it.
.script-build/
domain/.test-build-scratch/
apps/extension/e2e/content/.harness-build/
apps/extension/.test-build-scratch/

# Per-instance Lab build output and the lock that serializes the build phase.
# An instance's output sits under the package that produced it, so this matches
# at any depth. scripts/lab/lab-instance.mjs owns these paths; see
# docs/architecture/repository-layout.md.
.lab-instances/
.lab-locks/

# Generated bundles, untracked 2026-09-17. They were tracked without a recorded
# reason and nothing reads the committed copies: apps/extension/build/ has no
# manifest, icons or HTML and is not loadable -- browsers and the Lab load
# apps/extension/dist/<target>/, already ignored -- and domain/.test-build/ is
# written and imported inside one test-domain.mjs process. Tracking them made 55
# of every 100 commits carry generated output, and the sourcemaps are single
# 438KB-995KB lines that cannot be merged. Regenerate with the extension build
# and the domain test run. See docs/working/agent-git-workflow-plan.md.
apps/extension/build/
domain/.test-build/
