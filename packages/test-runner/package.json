{
  "name": "@fluxiq-web-extension/test-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "domain:dist": "node scripts/domain-dist.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "build": "node scripts/domain-dist.mjs && node ../../scripts/build-cache/cli.mjs test-runner:build -- \"node scripts/clean-dist.mjs && tsc -p tsconfig.json\"",
    "check": "node scripts/domain-dist.mjs && node ../../scripts/build-cache/cli.mjs test-runner:check -- \"tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/fluxiq-build/check.tsbuildinfo\"",
    "test": "node scripts/domain-dist.mjs && node ../../scripts/build-cache/cli.mjs test-runner:build && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@fluxiq-web-extension/domain": "workspace:*",
    "@fluxiq-web-extension/test-contracts": "workspace:*",
    "@fluxiq-web-extension/test-evidence": "workspace:*",
    "@playwright/test": "1.51.1",
    "fluxiq": "link:../../../!FluxIQ/packages/fluxiq"
  },
  "bin": {
    "fluxiq-lab": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
