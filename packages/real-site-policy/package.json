{
  "name": "@fluxiq-web-extension/real-site-policy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fluxiq-real-site-policy": "./dist/cli.js"
  },
  "exports": "./dist/index.js",
  "scripts": {
    "build": "node ../../scripts/build-cache/cli.mjs real-site-policy:build -- \"tsc -p tsconfig.json\"",
    "check": "node ../../scripts/build-cache/cli.mjs real-site-policy:check -- \"tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/fluxiq-build/check.tsbuildinfo\"",
    "test": "node ../../scripts/build-cache/cli.mjs real-site-policy:build && node --test dist/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
