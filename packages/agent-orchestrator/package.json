{
  "name": "@fluxiq-web-extension/agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fluxiq-agent-orchestrator": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-cache/cli.mjs agent-orchestrator:build -- \"tsc -p tsconfig.json\"",
    "check": "node ../../scripts/build-cache/cli.mjs agent-orchestrator:check -- \"tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/fluxiq-build/check.tsbuildinfo\"",
    "test": "node ../../scripts/build-cache/cli.mjs agent-orchestrator:build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fluxiq-web-extension/test-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
