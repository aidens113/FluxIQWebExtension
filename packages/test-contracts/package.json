{
  "name": "@fluxiq-web-extension/test-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/check/core-build.mjs && node ../../scripts/build-cache/cli.mjs test-contracts:build -- \"tsc -p tsconfig.json\"",
    "check": "node ../../scripts/check/core-build.mjs && node ../../scripts/build-cache/cli.mjs test-contracts:check -- \"tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/fluxiq-build/check.tsbuildinfo\"",
    "test": "node ../../scripts/check/core-build.mjs && node ../../scripts/build-cache/cli.mjs test-contracts:build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@fluxiq/contracts": "link:../../../!FluxIQ/packages/contracts"
  }
}
