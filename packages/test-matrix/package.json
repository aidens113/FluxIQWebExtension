{
  "name": "@fluxiq-web-extension/test-matrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fluxiq-test-matrix": "./dist/cli.js"
  },
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:registry": "pnpm --filter @fluxiq-web-extension/scenario-lab... build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build:registry && pnpm build && node --test dist/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
