{
  "name": "@fluxiq-web-extension/test-matrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fluxiq-test-matrix": "./dist/cli.js"
  },
  "exports": "./dist/index.js",
  "scripts": {
    "build": "node ../../scripts/build-cache/cli.mjs test-matrix:build -- \"tsc -p tsconfig.json\"",
    "build:registry": "node ../../scripts/build-cache/cli.mjs test-contracts:build && node ../../scripts/build-cache/cli.mjs scenario-lab:build",
    "check": "node ../../scripts/build-cache/cli.mjs test-matrix:check -- \"tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/fluxiq-build/check.tsbuildinfo\"",
    "test": "node ../../scripts/build-cache/cli.mjs test-contracts:build && node ../../scripts/build-cache/cli.mjs scenario-lab:build && node ../../scripts/build-cache/cli.mjs test-matrix:build && node --test dist/**/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
