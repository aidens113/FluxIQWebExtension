{
  "name": "@fluxiq-web-extension/test-evidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-cache/cli.mjs test-evidence:build -- \"tsc -p tsconfig.json\"",
    "check": "node ../../scripts/build-cache/cli.mjs test-evidence:check -- \"tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/fluxiq-build/check.tsbuildinfo\"",
    "test": "node ../../scripts/build-cache/cli.mjs test-evidence:build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fluxiq-web-extension/test-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
