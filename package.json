{
  "name": "fluxiq-web-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "agent:orchestrator": "pnpm --filter @fluxiq-web-extension/agent-orchestrator build && node packages/agent-orchestrator/dist/cli.js",
    "boundary:audit": "pnpm --filter @fluxiq-web-extension/boundary-audit build && node packages/boundary-audit/dist/cli.js --repository .",
    "build": "pnpm -r build",
    "check": "pnpm structure:test && node scripts/structure-audit.mjs && pnpm --filter @fluxiq-web-extension/domain build && pnpm -r check",
    "dev": "node scripts/run-fluxiq-web.mjs",
    "demo:record": "pnpm --filter @fluxiq-web-extension/scenario-lab build && pnpm --filter @fluxiq-web-extension/extension test:e2e:build && pnpm --filter @fluxiq-web-extension/test-runner... build && node scripts/record-demo-workspace.mjs",
    "demo:llm:setup": "node scripts/setup-demo-llm-key.mjs",
    "demo:llm:prepare": "node scripts/prepare-demo-llm-workspace.mjs",
    "demo:llm:diagnose": "node scripts/run-demo-llm-diagnosis.mjs",
    "demo:llm:create": "node scripts/run-demo-llm-creation.mjs",
    "demo:llm:create:focused": "node scripts/run-demo-llm-creation.mjs --no-build",
    "demo:llm:explore": "node scripts/run-demo-llm-exploration.mjs",
    "demo:llm:explore:request": "node scripts/inspect-demo-llm-exploration-request.mjs",
    "demo:llm:explore:request:apply": "node scripts/apply-demo-llm-exploration-request.mjs",
    "demo:llm:explore:request:run": "node scripts/run-demo-llm-exploration-request-flow.mjs",
    "demo:llm:explore:apply": "node scripts/apply-demo-llm-exploration-proposal.mjs",
    "demo:llm:explore:baseline": "node scripts/run-demo-llm-exploration-baseline.mjs",
    "demo:llm:explore:adapt:readiness": "node scripts/inspect-demo-llm-exploration-adaptation-readiness.mjs",
    "demo:llm:explore:adapt": "node scripts/run-demo-llm-exploration-adaptation.mjs",
    "demo:llm:explore:adapt:apply": "node scripts/apply-demo-llm-exploration-adaptation.mjs",
    "demo:llm:explore:adapt:validate": "node scripts/validate-demo-llm-exploration-adaptation.mjs",
    "demo:llm:explore:adapt:revert": "node scripts/revert-demo-llm-exploration-adaptation.mjs",
    "demo:llm:explore:adapt:reject": "node scripts/reject-demo-llm-exploration-adaptation.mjs",
    "demo:llm:pending": "node scripts/inspect-demo-llm-pending-creation.mjs",
    "demo:llm:state": "node scripts/inspect-demo-llm-applied-creation.mjs",
    "demo:llm:revert": "node scripts/revert-demo-llm-applied-creation.mjs",
    "demo:llm:replay": "node scripts/run-demo-llm-applied-replay.mjs",
    "demo:llm:adapt:readiness": "node scripts/inspect-demo-llm-adaptation-readiness.mjs",
    "demo:llm:adapt": "node scripts/run-demo-llm-adaptation.mjs",
    "demo:llm:adapt:focused": "node scripts/run-demo-llm-adaptation.mjs --no-build",
    "demo:llm:adapt:state": "node scripts/inspect-demo-llm-adaptation-run.mjs",
    "demo:llm:adapt:control": "node scripts/control-demo-llm-adaptation.mjs",
    "demo:llm:adapt:continue": "node scripts/control-demo-llm-adaptation.mjs continue",
    "demo:llm:adapt:revert": "node scripts/control-demo-llm-adaptation.mjs revert",
    "demo:llm:readiness": "node scripts/run-demo-llm-creation-readiness.mjs",
    "demo:llm:settings": "node scripts/run-demo-llm-creation-settings.mjs",
    "demo:run": "pnpm --filter @fluxiq-web-extension/scenario-lab build && pnpm --filter @fluxiq-web-extension/extension test:e2e:build && pnpm --filter @fluxiq-web-extension/test-runner... build && node scripts/run-demo-workspace-flow.mjs",
    "demo:setup-local": "pnpm --filter @fluxiq-web-extension/test-runner build && node scripts/setup-demo-local-env.mjs",
    "fluxiq:host:build": "pnpm --filter @fluxiq-web-extension/domain host:build",
    "fluxiq:setup": "pnpm --filter @fluxiq-web-extension/domain fluxiq:setup",
    "fluxiq:web": "node scripts/run-fluxiq-web.mjs",
    "lab": "pnpm --filter @fluxiq-web-extension/scenario-lab build && pnpm --filter @fluxiq-web-extension/extension test:e2e:build && pnpm --filter @fluxiq-web-extension/test-runner... build && node packages/test-runner/dist/cli.js",
    "lab:interactive": "pnpm --filter @fluxiq-web-extension/scenario-lab build && pnpm --filter @fluxiq-web-extension/extension test:e2e:build && pnpm --filter @fluxiq-web-extension/domain host:build && pnpm --filter @fluxiq-web-extension/test-runner... build && node packages/test-runner/dist/cli.js interactive",
    "real-site:policy": "pnpm --filter @fluxiq-web-extension/real-site-policy build && node packages/real-site-policy/dist/cli.js",
    "structure:check": "node scripts/structure-audit.mjs",
    "structure:baseline": "node scripts/structure-audit.mjs --update",
    "structure:test": "node --test \"scripts/structure-audit/rules/tests/*.test.mjs\" \"scripts/structure-audit/tests/*.test.mjs\"",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "typescript": "^5.7.0"
  }
}
