# Isolated is the safe default and requires no credentials.
FLUXIQ_TEST_TARGET=isolated

# To retain an isolated FluxIQ installation and browser profile between runs,
# use persistent-isolated with a portable lowercase workspace name. Its data is
# stored below FLUXIQ_TEST_RUNS_DIR/persistent-isolated/<workspace>/.
# FLUXIQ_TEST_TARGET=persistent-isolated
# FLUXIQ_TEST_PERSISTENT_WORKSPACE=web-extension-dev

# To attach deliberately to an existing installation, change the target to
# existing and provide every required value below. Use clone to read the same
# source Flow and import it into a disposable isolated destination. Clone does
# not require FLUXIQ_TEST_PIN because it never writes to or executes on the
# source. Never place real secrets in this tracked example.
# FLUXIQ_TEST_BASE_URL=http://127.0.0.1:3000
# FLUXIQ_TEST_GATEWAY_URL=ws://127.0.0.1:3001/client
# FLUXIQ_TEST_USERNAME=replace-with-test-user
# FLUXIQ_TEST_PASSWORD=replace-with-secret
# FLUXIQ_TEST_PIN=replace-with-authorization-pin
# FLUXIQ_TEST_TOTP=replace-with-current-totp-if-required
# FLUXIQ_TEST_PROJECT_ID=replace-with-existing-project-id
# FLUXIQ_TEST_FLOW_ID=replace-with-existing-flow-id

# Reusable self-recording demo workspace. The directory must stay below
# FLUXIQ_TEST_RUNS_DIR and is reused by pnpm demo:record and pnpm demo:run.
# FLUXIQ_DEMO_RUN_DIR=F:/!FluxIQWebExtension/test-runs/web-extension-demo
# The demo owns a persistent isolated Core on stable loopback ports so cached
# panel and extension sessions remain reusable across process restarts.
# FLUXIQ_DEMO_BASE_URL=http://127.0.0.1:3300
# FLUXIQ_DEMO_GATEWAY_URL=ws://127.0.0.1:4877/client
# FLUXIQ_CORE_ROOT=F:/!FluxIQ
# FLUXIQ_DEMO_PROJECT_ID=optional-existing-web-automation-project-id
# FLUXIQ_DEMO_PROJECT_NAME=FluxIQ Web Extension Test
# FLUXIQ_DEMO_FLOW_ID=flow.web-extension-demo
# FLUXIQ_DEMO_FLOW_NAME=Web Extension Demo Flow
# Runs invisibly by default. Set false only for interactive browser debugging.
# FLUXIQ_DEMO_HEADLESS=true
