{
  "manifest_version": 3,
  "name": "FluxIQ Web Automation Client",
  "description": "Browser recorder and action client for FluxIQ.",
  "version": "0.1.0",
  "action": {
    "default_title": "FluxIQ",
    "default_popup": "popup/index.html"
  },
  "background": {
    "scripts": ["background/index.js"],
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fluxiq-web-automation@example.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
